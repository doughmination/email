{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "email",
	"main": "server.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "email_db",
			"database_name": "email-db",
			"database_id": "5dbd0d25-8c8a-49c8-83c6-768bda4e9c19"
		}
	],
	"vars": {
		"OIDC_SCOPE": "openid profile email offline_access",
		"VAPID_SUBJECT": "mailto:admin@doughmination.gay",
		"COOKIE_SECURE": "true",
		"OIDC_ISSUER": "https://auth.doughmination.gay",
		"OIDC_CLIENT_ID": "cc067f21-88ca-4927-ac7b-26d21968d2e1",
		"OIDC_REDIRECT_URI": "https://mail.doughmination.gay/auth/callback",
		"OIDC_POST_LOGOUT_REDIRECT_URI": "https://mail.doughmination.gay",
		"SEND_FROM": "",
		"VAPID_PUBLIC_KEY": "BJs_bZo392RyXRrh4LNcYxJ2qIhPVaOhWqOIVbsC4HTy5IlKmdGrF4bNuFiFOWAe7udwLbCDvjVX03IChs35Lp8"
	}
}
