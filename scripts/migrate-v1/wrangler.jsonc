// Never deployed: run with `wrangler dev`, which runs the code locally but
// talks to the real databases and bucket ("remote": true). See README.md.
{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "email-migrate-v1",
	"main": "worker.ts",
	"account_id": "f87ee4b9600f437b8da1104d077418c3",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "OLD_DB",
			"database_name": "email-db",
			"database_id": "5dbd0d25-8c8a-49c8-83c6-768bda4e9c19",
			"remote": true
		},
		{
			"binding": "DB",
			"database_name": "email-db-v2",
			"database_id": "c6a27bce-97c3-4b10-ad2a-df4a308f494f",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "email-attachments",
			"remote": true
		}
	]
}
