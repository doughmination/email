{
  "name": "doughminaiton-inbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types src/worker/worker-configuration.d.ts --env-file .dev.vars.example",
    "typecheck": "tsc -p src/worker && tsc -p test && svelte-check --tsconfig src/web/tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "hono": "4.13.13",
    "iconsax": "0.1.1",
    "jose": "6.2.12",
    "resend": "6.32.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.5",
    "standardwebhooks": "1.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
